{
  "name": "opencode-desktop-prompt-enhancer",
  "version": "0.3.1",
  "private": true,
  "description": "OpenCode Desktop GUI plugin: /enhance rewrites the current composer draft with the current model.",
  "keywords": [
    "opencode",
    "opencode-desktop",
    "gui-plugin",
    "prompt"
  ],
  "type": "module",
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.0"
  },
  "devDependencies": {
    "solid-js": "^1.9.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
